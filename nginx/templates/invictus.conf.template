# Rendered from this template by the official nginx image's entrypoint
# (envsubst on /etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf)
# using the DOMAIN env var passed to the nginx service in docker-compose.
# nginx's own runtime variables (like $host, $request_uri, $scheme) are left
# untouched since they aren't container env vars.

# HTTP: serve ACME HTTP-01 challenges for certbot, redirect everything else.
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: terminate TLS, reverse proxy to the Next.js app container.
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS is the ONE security header set here rather than in the app: it may
    # only be sent over TLS, and the app cannot tell whether this proxy
    # terminated HTTPS or is serving plain HTTP behind something else.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # Every other security header — including the Content-Security-Policy —
    # comes from the app (next.config.js) and passes straight through, exactly
    # as host-invictus.conf.example already documents for the other deploy path.
    #
    # Do NOT re-add them here. nginx's add_header APPENDS to a proxied
    # response rather than replacing, so a second CSP is not a safety net: the
    # browser enforces the INTERSECTION of both policies. This block used to
    # send `script-src 'self'`, which silently subtracted the sha256 hash that
    # allows the pre-paint theme script — leaving the theme to resolve only
    # after hydration (a flash of the wrong palette on every load) and the `js`
    # class never set, which disables every scroll reveal on the site.
    #
    # The app's hash is derived from the same THEME_SCRIPT constant the document
    # renders, so it cannot drift. A copy pasted here always can.

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # API routes get the proxy-level rate limit (zone defined in nginx.conf).
    # burst absorbs a legitimate quick double-submit; nodelay rejects the
    # rest immediately instead of queueing them.
    location /api/ {
        limit_req zone=api burst=10 nodelay;

        proxy_pass http://invictus:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://invictus:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
